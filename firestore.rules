rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid || admin(); allow write: if signedIn() && request.auth.uid == uid || admin(); }
    match /licenses/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid || admin(); allow write: if admin(); }
    match /wallets/{id} { allow read: if signedIn() && id == request.auth.uid || admin(); allow write: if false; }
    match /creditTransactions/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid || admin(); allow write: if false; }
    match /payments/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid || admin(); allow write: if false; }
    match /devices/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid || admin(); allow write: if false; }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /creditPackages/{id} { allow read: if true; allow write: if admin(); }
  }
}
